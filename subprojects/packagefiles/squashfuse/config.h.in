/*
 * squashfuse config.h, generated by meson (see the meson.build beside this
 * file) instead of by autotools ./configure. Only the macros the low-level
 * library actually reads are listed. Compression is zstd + zlib, so the
 * HAVE_{LZMA,LZ4,LZO}_H macros are intentionally absent, which is what makes
 * decompress.c compile in only CAN_DECOMPRESS_ZSTD and CAN_DECOMPRESS_ZLIB.
 */
#ifndef SQFS_MESON_CONFIG_H
#define SQFS_MESON_CONFIG_H

/* FUSE (fuse3 only); the decl checks are probed against the fuse3 headers */
#mesondefine FUSE_USE_VERSION
#mesondefine HAVE_DECL_FUSE_ADD_DIRENT
#mesondefine HAVE_DECL_FUSE_ADD_DIRENTRY
#mesondefine HAVE_DECL_FUSE_CMDLINE_HELP
#mesondefine HAVE_DECL_FUSE_DAEMONIZE
#mesondefine HAVE_DECL_FUSE_SESSION_REMOVE_CHAN
#mesondefine HAVE_FUSE_LL_FORGET_OP_64T

/* platform headers / features */
#mesondefine HAVE_ASM_BYTEORDER_H
#mesondefine HAVE_DLFCN_H
#mesondefine HAVE_ENDIAN_H
#mesondefine HAVE_INTTYPES_H
#mesondefine HAVE_LIBPTHREAD
#mesondefine HAVE_LINUX_TYPES_LE16
#mesondefine HAVE_STDINT_H
#mesondefine HAVE_STDIO_H
#mesondefine HAVE_STDLIB_H
#mesondefine HAVE_STRINGS_H
#mesondefine HAVE_STRING_H
#mesondefine HAVE_SYS_STAT_H
#mesondefine HAVE_SYS_SYSMACROS_H
#mesondefine HAVE_SYS_TYPES_H
#mesondefine HAVE_UNISTD_H
#mesondefine HAVE_WCHAR_H
#mesondefine STDC_HEADERS

/* compression backends: zstd + zlib */
#mesondefine HAVE_ZSTD_H
#mesondefine HAVE_ZLIB_H

/* enable the multi-threaded low-level FUSE driver */
#mesondefine SQFS_MULTITHREADED

/* package metadata */
#mesondefine LT_OBJDIR
#mesondefine PACKAGE
#mesondefine PACKAGE_BUGREPORT
#mesondefine PACKAGE_NAME
#mesondefine PACKAGE_STRING
#mesondefine PACKAGE_TARNAME
#mesondefine PACKAGE_URL
#mesondefine PACKAGE_VERSION
#mesondefine VERSION

#endif /* SQFS_MESON_CONFIG_H */
